let currentEstado = 'USADO';
let charts = {};

function initFilters() {
  const fill = (id, key) => {
    const vals = [...new Set(RAW_DATA.map(d => d[key]))].sort();
    const sel = document.getElementById(id);
    vals.forEach(v => {
      const opt = document.createElement('option');
      opt.value = v; opt.textContent = v;
      sel.appendChild(opt);
    });
  };
  fill('f-genero', 'gen');
  fill('f-etnia', 'etn');
  fill('f-depto', 'dep');
  fill('f-esc', 'esc');
}

function setEstado(est) {
  currentEstado = est;
  ['USADO', 'TODOS', 'PENDIENTE'].forEach(k => {
    const b = document.getElementById('btn-' + k);
    b.className = k === est
      ? 'px-4 py-2 rounded-xl text-sm font-semibold bg-indigo-600 text-white shadow-sm transition'
      : 'px-4 py-2 rounded-xl text-sm font-semibold bg-slate-100 text-slate-700 hover:bg-slate-200 transition';
  });
  render();
}

function countBy(arr, key) {
  const map = {};
  arr.forEach(d => { const v = d[key] || 'Sin datos'; map[v] = (map[v] || 0) + 1; });
  return Object.entries(map).sort((a, b) => b[1] - a[1]);
}

function updateChart(id, type, labels, data, colors, horizontal = false) {
  if (charts[id]) charts[id].destroy();
  charts[id] = new Chart(document.getElementById(id), {
    type,
    data: {
      labels,
      datasets: [{
        label: 'Participantes',
        data,
        backgroundColor: colors,
        borderRadius: type === 'bar' ? 6 : 0,
        fill: type === 'line',
        borderColor: '#4f46e5',
        tension: 0.35
      }]
    },
    options: {
      indexAxis: horizontal ? 'y' : 'x',
      responsive: true,
      plugins: { legend: { display: type === 'doughnut' || type === 'pie', position: 'bottom' } },
      scales: (type === 'bar' || type === 'line') ? { y: { beginAtZero: true, ticks: { precision: 0 } } } : {}
    }
  });
}

function render() {
  const fg = document.getElementById('f-genero').value;
  const fe = document.getElementById('f-etnia').value;
  const fd = document.getElementById('f-depto').value;
  const fs = document.getElementById('f-esc').value;
  const q = document.getElementById('f-search').value.toLowerCase().trim();

  const filtered = RAW_DATA.filter(d => {
    if (currentEstado !== 'TODOS' && d.est !== currentEstado) return false;
    if (fg !== 'ALL' && d.gen !== fg) return false;
    if (fe !== 'ALL' && d.etn !== fe) return false;
    if (fd !== 'ALL' && d.dep !== fd) return false;
    if (fs !== 'ALL' && d.esc !== fs) return false;
    if (q && !(d.n.toLowerCase().includes(q) || d.emp.toLowerCase().includes(q) || d.mun.toLowerCase().includes(q))) return false;
    return true;
  });

  // KPIs
  document.getElementById('kpi-total').textContent = filtered.length;
  document.getElementById('kpi-sub').textContent = `De ${RAW_DATA.length} registros totales`;

  const fem = filtered.filter(d => d.gen === 'Femenino').length;
  const conFicha = filtered.filter(d => d.gen !== 'Sin datos').length;
  document.getElementById('kpi-fem').textContent = filtered.length ? ((fem / filtered.length) * 100).toFixed(1) + '%' : '0%';
  document.getElementById('kpi-fem-sub').textContent = `${fem} mujeres (${conFicha ? ((fem/conFicha)*100).toFixed(1) : 0}% con ficha)`;

  const edades = filtered.map(d => d.edad).filter(e => e !== null);
  const avgEdad = edades.length ? (edades.reduce((a, b) => a + b, 0) / edades.length).toFixed(1) : 'N/A';
  document.getElementById('kpi-edad').textContent = edades.length ? `${avgEdad} años` : 'N/A';
  document.getElementById('kpi-edad-sub').textContent = edades.length ? `Rango: ${Math.min(...edades)} a ${Math.max(...edades)} años` : 'Sin datos de edad';

  const sup = filtered.filter(d => ['Universidad o instituto superior completa', 'Algunos años de universidad o instituto superior', 'Postgrado (eje. Maestría o Doctorado)'].includes(d.esc)).length;
  document.getElementById('kpi-sup').textContent = filtered.length ? ((sup / filtered.length) * 100).toFixed(1) + '%' : '0%';

  // Charts
  const gData = countBy(filtered, 'gen');
  updateChart('chartGenero', 'doughnut', gData.map(x => x[0]), gData.map(x => x[1]), ['#ec4899', '#94a3b8', '#3b82f6']);

  const eData = countBy(filtered, 'etn');
  updateChart('chartEtnia', 'doughnut', eData.map(x => x[0]), eData.map(x => x[1]), ['#6366f1', '#10b981', '#f59e0b', '#94a3b8', '#8b5cf6']);

  const bins = { '16-24': 0, '25-34': 0, '35-44': 0, '45-54': 0, '55+': 0 };
  edades.forEach(e => {
    if (e <= 24) bins['16-24']++;
    else if (e <= 34) bins['25-34']++;
    else if (e <= 44) bins['35-44']++;
    else if (e <= 54) bins['45-54']++;
    else bins['55+']++;
  });
  updateChart('chartEdad', 'bar', Object.keys(bins), Object.values(bins), '#10b981');

  const escData = countBy(filtered, 'esc');
  updateChart('chartEscolaridad', 'bar', escData.map(x => x[0].replace('Universidad o instituto superior ', 'Univ. ')), escData.map(x => x[1]), '#6366f1', true);

  const munData = countBy(filtered, 'mun').slice(0, 8);
  updateChart('chartMunicipio', 'bar', munData.map(x => x[0]), munData.map(x => x[1]), '#f59e0b', true);

  // Check-in curve (08:30 to 14:30 local time)
  const slots = ['08:30', '09:00', '09:30', '10:00', '10:30', '11:00', '11:30', '12:00', '12:30', '13:00', '13:30', '14:00', '14:30'];
  const slotCounts = Object.fromEntries(slots.map(s => [s, 0]));
  filtered.forEach(d => {
    if (!d.chk) return;
    const [hh, mm] = d.chk.split(':').map(Number);
    const key = `${String(hh).padStart(2, '0')}:${mm < 30 ? '00' : '30'}`;
    if (slotCounts[key] !== undefined) slotCounts[key]++;
  });
  updateChart('chartCheckin', 'line', slots, slots.map(s => slotCounts[s]), 'rgba(79,70,229,0.15)');

  // Table
  document.getElementById('table-count').textContent = `Mostrando ${filtered.length} registros`;
  document.getElementById('table-body').innerHTML = filtered.map(d => `
    <tr class="hover:bg-slate-50">
      <td class="py-2.5 px-4 font-medium text-slate-900">${d.n}</td>
      <td class="py-2.5 px-4 text-slate-600">${d.emp}</td>
      <td class="py-2.5 px-4"><span class="px-2 py-0.5 rounded-full text-xs font-semibold ${d.est === 'USADO' ? 'bg-emerald-100 text-emerald-700' : 'bg-amber-100 text-amber-700'}">${d.est}</span></td>
      <td class="py-2.5 px-4 text-slate-500">${d.chk || '—'}</td>
      <td class="py-2.5 px-4 text-slate-600">${d.gen}</td>
      <td class="py-2.5 px-4 text-slate-600">${d.etn}</td>
      <td class="py-2.5 px-4 text-slate-600">${d.edad ?? '—'}</td>
      <td class="py-2.5 px-4 text-slate-600">${d.mun}</td>
    </tr>
  `).join('');
}

initFilters();
render();
</script>
</body>
</html>
