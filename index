<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Dashboard Estadístico - Summit Corali</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<body class="bg-slate-50 text-slate-800 font-sans">
  <div class="max-w-7xl mx-auto px-4 py-6">
    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-center md:justify-between bg-white p-6 rounded-2xl shadow-sm border border-slate-200 mb-6">
      <div>
        <span class="text-xs font-bold uppercase tracking-wider text-indigo-600 bg-indigo-50 px-3 py-1 rounded-full">Análisis de Participación</span>
        <h1 class="text-2xl md:text-3xl font-bold text-slate-900 mt-2">Summit Corali — Tablero Interactivo</h1>
        <p class="text-sm text-slate-500 mt-1">Horario corregido (-5h UTC → Hora Local 08:34–14:37) · Enfoque principal: Participantes USADO</p>
      </div>
      <div class="mt-4 md:mt-0 flex flex-wrap gap-2">
        <button onclick="setEstado('USADO')" id="btn-USADO" class="px-4 py-2 rounded-xl text-sm font-semibold bg-indigo-600 text-white shadow-sm transition">Participaron (USADO)</button>
        <button onclick="setEstado('TODOS')" id="btn-TODOS" class="px-4 py-2 rounded-xl text-sm font-semibold bg-slate-100 text-slate-700 hover:bg-slate-200 transition">Todos (176)</button>
        <button onclick="setEstado('PENDIENTE')" id="btn-PENDIENTE" class="px-4 py-2 rounded-xl text-sm font-semibold bg-slate-100 text-slate-700 hover:bg-slate-200 transition">No asistieron (PENDIENTE)</button>
      </div>
    </div>

    <!-- Filtros secundarios -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4 bg-white p-4 rounded-2xl shadow-sm border border-slate-200 mb-6">
      <div>
        <label class="block text-xs font-semibold text-slate-500 uppercase mb-1">Género</label>
        <select id="f-genero" onchange="render()" class="w-full rounded-lg border-slate-300 border px-3 py-2 text-sm bg-slate-50">
          <option value="ALL">Todos</option>
        </select>
      </div>
      <div>
        <label class="block text-xs font-semibold text-slate-500 uppercase mb-1">Etnia</label>
        <select id="f-etnia" onchange="render()" class="w-full rounded-lg border-slate-300 border px-3 py-2 text-sm bg-slate-50">
          <option value="ALL">Todas</option>
        </select>
      </div>
      <div>
        <label class="block text-xs font-semibold text-slate-500 uppercase mb-1">Departamento</label>
        <select id="f-depto" onchange="render()" class="w-full rounded-lg border-slate-300 border px-3 py-2 text-sm bg-slate-50">
          <option value="ALL">Todos</option>
        </select>
      </div>
      <div>
        <label class="block text-xs font-semibold text-slate-500 uppercase mb-1">Escolaridad</label>
        <select id="f-esc" onchange="render()" class="w-full rounded-lg border-slate-300 border px-3 py-2 text-sm bg-slate-50">
          <option value="ALL">Todas</option>
        </select>
      </div>
      <div>
        <label class="block text-xs font-semibold text-slate-500 uppercase mb-1">Buscar Nombre / Empresa</label>
        <input id="f-search" oninput="render()" type="text" placeholder="Ej. Pastelería, Maya..." class="w-full rounded-lg border-slate-300 border px-3 py-2 text-sm bg-slate-50" />
      </div>
    </div>

    <!-- KPIs -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
      <div class="bg-white p-5 rounded-2xl shadow-sm border border-slate-200">
        <p class="text-xs font-semibold text-slate-500 uppercase">Registros Filtrados</p>
        <p id="kpi-total" class="text-3xl font-bold text-indigo-600 mt-1">0</p>
        <p id="kpi-sub" class="text-xs text-slate-400 mt-1"></p>
      </div>
      <div class="bg-white p-5 rounded-2xl shadow-sm border border-slate-200">
        <p class="text-xs font-semibold text-slate-500 uppercase">Participación Femenina</p>
        <p id="kpi-fem" class="text-3xl font-bold text-pink-600 mt-1">0%</p>
        <p id="kpi-fem-sub" class="text-xs text-slate-400 mt-1"></p>
      </div>
      <div class="bg-white p-5 rounded-2xl shadow-sm border border-slate-200">
        <p class="text-xs font-semibold text-slate-500 uppercase">Edad Promedio</p>
        <p id="kpi-edad" class="text-3xl font-bold text-emerald-600 mt-1">0 años</p>
        <p id="kpi-edad-sub" class="text-xs text-slate-400 mt-1"></p>
      </div>
      <div class="bg-white p-5 rounded-2xl shadow-sm border border-slate-200">
        <p class="text-xs font-semibold text-slate-500 uppercase">Educación Superior</p>
        <p id="kpi-sup" class="text-3xl font-bold text-amber-600 mt-1">0%</p>
        <p class="text-xs text-slate-400 mt-1">Univ. completa, incompleta o postgrado</p>
      </div>
    </div>

    <!-- Gráficas Fila 1 -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-6">
      <div class="bg-white p-5 rounded-2xl shadow-sm border border-slate-200">
        <h3 class="text-sm font-bold text-slate-700 mb-3">Distribución por Género</h3>
        <canvas id="chartGenero" height="220"></canvas>
      </div>
      <div class="bg-white p-5 rounded-2xl shadow-sm border border-slate-200">
        <h3 class="text-sm font-bold text-slate-700 mb-3">Identidad Étnica</h3>
        <canvas id="chartEtnia" height="220"></canvas>
      </div>
      <div class="bg-white p-5 rounded-2xl shadow-sm border border-slate-200">
        <h3 class="text-sm font-bold text-slate-700 mb-3">Rangos de Edad</h3>
        <canvas id="chartEdad" height="220"></canvas>
      </div>
    </div>

    <!-- Gráficas Fila 2 -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-6">
      <div class="bg-white p-5 rounded-2xl shadow-sm border border-slate-200">
        <h3 class="text-sm font-bold text-slate-700 mb-3">Nivel de Escolaridad</h3>
        <canvas id="chartEscolaridad" height="220"></canvas>
      </div>
      <div class="bg-white p-5 rounded-2xl shadow-sm border border-slate-200">
        <h3 class="text-sm font-bold text-slate-700 mb-3">Top Municipios de Procedencia</h3>
        <canvas id="chartMunicipio" height="220"></canvas>
      </div>
    </div>

    <!-- Gráfica Check-in -->
    <div class="bg-white p-5 rounded-2xl shadow-sm border border-slate-200 mb-6">
      <h3 class="text-sm font-bold text-slate-700 mb-3">Curva de Llegada / Check-in (Hora Local Corregida — Intervalos de 30 min)</h3>
      <canvas id="chartCheckin" height="95"></canvas>
    </div>

    <!-- Tabla de detalle -->
    <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
      <div class="p-5 border-b border-slate-200 flex justify-between items-center">
        <h3 class="text-sm font-bold text-slate-700">Directorio de Participantes Filtrados</h3>
        <span id="table-count" class="text-xs font-semibold text-slate-500"></span>
      </div>
      <div class="overflow-x-auto max-h-96">
        <table class="min-w-full text-left text-sm">
          <thead class="bg-slate-100 text-slate-600 sticky top-0">
            <tr>
              <th class="py-3 px-4 font-semibold">Nombre</th>
              <th class="py-3 px-4 font-semibold">Empresa / Emprendimiento</th>
              <th class="py-3 px-4 font-semibold">Estado</th>
              <th class="py-3 px-4 font-semibold">Check-in (Local)</th>
              <th class="py-3 px-4 font-semibold">Género</th>
              <th class="py-3 px-4 font-semibold">Etnia</th>
              <th class="py-3 px-4 font-semibold">Edad</th>
              <th class="py-3 px-4 font-semibold">Municipio</th>
            </tr>
          </thead>
          <tbody id="table-body" class="divide-y divide-slate-100"></tbody>
        </table>
      </div>
    </div>
  </div>

